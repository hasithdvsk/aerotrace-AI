// Prisma Schema for AeroTrace AI - PostGIS & TimescaleDB Setup

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum GasType {
  CH4
  CO2
  CO
}

model SensorNode {
  nodeId         String         @id @map("node_id") @db.VarChar(64)
  busRouteId     String?        @map("bus_route_id") @db.VarChar(64)
  status         String         @default("ACTIVE") @db.VarChar(32)
  lastCalibrated DateTime?      @map("last_calibrated") @db.Timestamptz(6)
  offsetPm25     Float?         @default(0.0) @map("offset_pm25")
  offsetCo2      Float?         @default(0.0) @map("offset_co2")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  telemetry      IotTelemetry[]

  @@map("sensor_nodes")
}

model IotTelemetry {
  id          String                                @default(uuid()) @db.Uuid
  time        DateTime                              @db.Timestamptz(6)
  nodeId      String                                @map("node_id") @db.VarChar(64)
  node        SensorNode                            @relation(fields: [nodeId], references: [nodeId], onDelete: Cascade)

  latitude    Decimal?                              @db.Decimal(10, 8)
  longitude   Decimal?                              @db.Decimal(11, 8)
  location    Unsupported("geometry(Point, 4326)")?

  pm2_5       Float?                                @map("pm2_5")
  pm10        Float?                                @map("pm10")
  co2         Float?                                @map("co2")
  no2         Float?                                @map("no2")
  voc         Float?                                @map("voc")
  temperature Float?                                @map("temperature")
  humidity    Float?                                @map("humidity")
  pressure    Float?                                @map("pressure")

  // TimescaleDB partition composite primary key
  @@id([time, id])
  @@index([nodeId, time(sort: Desc)])
  @@map("iot_telemetry")
}

model SatelliteMacroData {
  id             String                                  @id @default(uuid()) @db.Uuid
  capturedAt     DateTime                                @map("captured_at") @db.Timestamptz(6)
  gasType        GasType                                 @map("gas_type")
  boundingBox    Unsupported("geometry(Polygon, 4326)")? @map("bounding_box")
  rasterTilePath String?                                 @map("raster_tile_path") @db.Text
  createdAt      DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([gasType, capturedAt(sort: Desc)])
  @@map("satellite_macro_data")
}

model StreetAqiGrid {
  gridId            String                                    @id @default(uuid()) @map("grid_id") @db.Uuid
  calculatedAt      DateTime                                  @default(now()) @map("calculated_at") @db.Timestamptz(6)
  streetSegmentId   String?                                   @map("street_segment_id") @db.VarChar(128)
  geometry          Unsupported("geometry(LineString, 4326)")
  interpolatedAqi   Float                                     @map("interpolated_aqi")
  confidenceScore   Float?                                    @map("confidence_score")

  // Supplementary compatibility fields
  gridCode          String?                                   @unique @map("grid_code") @db.VarChar(64)
  streetName        String?                                   @map("street_name") @db.VarChar(255)
  currentAqi        Int?                                      @map("current_aqi")
  pm25              Float?                                    @map("pm2_5")
  dominantPollutant String?                                   @map("dominant_pollutant") @db.VarChar(16)

  @@map("street_aqi_grid")
}
