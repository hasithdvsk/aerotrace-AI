{
  "name": "hyperlocal-aqi-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "db:generate": "npm run generate --workspace=@repo/db",
    "db:migrate": "npm run migrate:dev --workspace=@repo/db",
    "dev:ai": "uvicorn app.main:app --app-dir apps/ai-engine --host 0.0.0.0 --port 8000 --reload",
    "test:ai": "pytest apps/ai-engine/tests/test_api.py",
    "firmware:build": "python -m platformio run -d iot-firmware",
    "firmware:clean": "python -m platformio run -d iot-firmware -t clean",
    "test:e2e": "ts-node scripts/e2e-system-test.ts",
    "simulate:fleet": "ts-node scripts/simulate-bus-fleet.ts"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.13",
    "node-fetch": "^3.3.2",
    "ts-node": "^10.9.2"
  }
}
