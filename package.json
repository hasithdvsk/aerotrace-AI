{
  "name": "hyperlocal-aqi-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "db:generate": "npm run generate --workspace=@repo/db",
    "db:migrate": "npm run migrate:dev --workspace=@repo/db"
  }
}
